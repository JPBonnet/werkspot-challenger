{
  "name": "werkspot-challenger",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/shared-types/src/supabase.ts && node packages/shared-types/scripts/gen-dart.mjs",
    "db:test": "supabase test db",
    "ai:evals": "turbo run evals --filter=@werkspot/ai-evals",
    "mobile:dev": "cd apps/mobile && flutter run",
    "mobile:test": "cd apps/mobile && flutter test",
    "mobile:analyze": "cd apps/mobile && flutter analyze",
    "security:review": "pnpm lint && pnpm typecheck && pnpm db:test",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3",
    "eslint": "^9.10.0",
    "husky": "^9.1.5"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    }
  }
}
