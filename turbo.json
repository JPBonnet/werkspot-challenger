{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "evals": {
      "cache": false
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_*",
    "SUPABASE_*",
    "STRIPE_*",
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "SENTRY_*",
    "POSTHOG_*",
    "MESSAGEBIRD_API_KEY",
    "KVK_API_KEY",
    "MAPBOX_ACCESS_TOKEN",
    "RESEND_API_KEY"
  ]
}
